NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OAuth Google (Supabase local). No projeto hospedado, configure no Dashboard:
# Authentication > URL Configuration
#   Site URL = https://facilito-bonus.vercel.app
#   Redirect URLs =
#     https://facilito-bonus.vercel.app/auth/callback
#     https://facilito-bonus.vercel.app/**
#     http://localhost:3000/auth/callback
#     http://127.0.0.1:3000/auth/callback
# Google Cloud Console (cliente Web):
#   Origens JS = https://<project-ref>.supabase.co
#   Redirect URI = https://<project-ref>.supabase.co/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
